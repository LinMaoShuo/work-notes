def _common_check_func(get_detail_func, get_detail_para, status_para_name, expected_status, check_para, timeout,
                       interval=10):
    """
    公共检查方法，传入方法查询转改还是和检查参数，返回检查结果、以及最近一次检查信息
    :param get_detail_func: 获取检查对象的函数
    :param get_detail_para: 列表，获取检查对象的函数的参数列表
    :param status_para_name： 状态字段名称
    :param expected_status: 预期状态值，对应status_para_name字段
    :param check_para: 检查变量，key是字段，value是预期值
    :param timeout: 超时时长
    :return:
        True / False 表示检车是否成功
        detail 检查信息
    """
    wait_time = 0
    interval = interval
    detail = ''
    while wait_time <= timeout:
        check_flag = True
        try:
            detail = get_detail_func(*get_detail_para)
        except ValueError:
            detail = None
        # 检查VPC不存在
        if not detail and not expected_status:
            # 检查成功
            return True, detail
        # 检查状态
        if not detail or detail[status_para_name] != expected_status:
            check_flag = False
        # 检查其他可选参数
        for para_path, para_expect in check_para.items():
            if check_flag and detail.get_conf(para_path) != para_expect:
                check_flag = False
                break
        if check_flag:
            return True, detail
        wait_time += interval
        time.sleep(interval)
    return False, detail


class TcsmScOpenApi(ApiClient, CommonApi):
