    def get_token(self):
        """
        ---------------
        北向接口鉴权
        ---------------
        :return:
        """
        send_data = {
            'callerId': self.callerId,
            'meoId': self.meoId,
            'username': self.username,
            'password': self.password
        }
        r = self.request_return_all('POST', '/v1/caller/authentication/token', send_data)
        self.set_header('X-Auth-Token', r.headers.get('x-subject-token'))
        self._vpc()
        self._vpc_ids()

    def get_token_origin(self):
        """
        ------------------------------
        北向接口鉴权(无租户状态)
        ------------------------------
        :return:
        """
        send_data = {
            'callerId': self.callerId,
