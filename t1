    def check_task(self, job_id, timeout: int = 30, interval_time: int = 10):
        """
        -------------------
        查询任务状态
        -------------------
        :param job_id: 任务ID
        :param timeout: 检查任务超时时间（单位：秒）
        :param interval_time: 每一次查询的间隔时间（单位：秒）
        :return: True/False
        """
        url = f'/v1/jobs/{job_id}?callerId={self.callerId}&meoId={self.meoId}&ResponseId='
        times = 0
        while times <= timeout:
            time.sleep(interval_time)
            times += interval_time
            try:
                task = self.request('GET', url)
                task_status = task.jobStatus
            except AttributeError:
                continue
            if task_status == 'ERROR' or task_status == 'Error':
                logger.error('任务执行失败')
                return False
            if task_status == 'SUCCESS' or task_status == 'Success':
                return True
        logger.error('检查任务超时')
        return False

    def _get_region(self):
        sites = self.request('GET', f'/v1/sites?callerId={self.callerId}&meoId={self.meoId}')
        return sites.siteList

    def _volume_type(self):
        url = f'/v1/cloudservice/volumetype?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}&' \
              f'siteId={self.region_id}'
        return self.request('GET', url).get('volumeTypeList')

    def _security_group(self):
        url = f'/v1/os-security-groups?callerId={self.callerId}&siteId={self.region_id}&meoId={self.meoId}&userId={self.tenant_id}'
        return self.request('GET', url).get('securityGroups')

    def _vpc_ids(self, forced=True):
        """
        ---------------------------------------------------------
        查询并保存VPC的ID，保存key为VPC名称，value为VPC ID的字典
        ---------------------------------------------------------
        :param forced:
        :return:
        """
        if not forced and self.vpc_ids:
            return
        url = f'/v1/vpcs?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}&siteId={self.region_id}'
        vpcs = self.request('GET', url).get('vpcs')
        for vpc in vpcs:
            vpc_name = vpc.get('vpcName')
            self.vpc_ids[vpc_name] = vpc.vpcId

    def _vpc(self, forced=True):
        """
        --------------------------------------
        获取VPC信息、网络信息、子网信息分别保存为字典
        --------------------------------------
        self.vpc：{vpc_name: vpc_info}
        self.network：{vpc_name: {net_name: net_info}}
        self.subnet：{vpc_name: {net_name: {ipVersion: sub_info}}}
        :param forced:
        :return:
        """
        if not forced and self.vpc:
            return
        url = f'/v1/vpcs?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}&siteId={self.region_id}'
        vpcs = self.request('GET', url).get('vpcs')
        vps_names = []
        for vpc in vpcs:
            vpc_name = vpc.vpcName
            vps_names.append(vpc_name)
            self.vpc[vpc_name] = self._get_vpc_detail(vpc.vpcId)
        for vn in vps_names:
            self.network[vn] = {net.networkName: net for net in self.vpc[vn]['networks']}
        for vn1 in vps_names:
            n = {}
            for net_name, value in self.network[vn1].items():
                s = {}
                for sub in value['subnets']:
                    s[sub['ipVersion']] = sub
                n[net_name] = s
            self.subnet[vn1] = n

    def _ecs_ids(self, forced=True):
        """
        ---------------------------------------------------------
        查询并保存ecs的ID，保存key为ecs名称，value为ecs ID的字典
        ---------------------------------------------------------
        :param forced:
        :return:
        """
        if not forced and self.ecs_ids:
            return
        url = f'/v1/cloudservers?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        ecss = self.request('GET', url)
        for ecs in ecss.get('servers'):
            ecs_name = ecs.serverName
            self.ecs_ids[ecs_name] = ecs.id

    def _ecs(self, forced=True):
        """
        -----------------------------------
        获取ecs信息、port信息、分别保存为字典：
        -----------------------------------
        self.ecs：{ecs_name: {}}
        self.ports：{ecs_name: {network_name: {}}}
        :param forced:
        :return:
        """
        if not forced and self.ecs:
            return
        url = f'/v1/cloudservers?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        ecss = self.request('GET', url)
        ecs_names = []
        if ecss:
            for ecs in ecss.get('servers'):
                ecs_name = ecs.serverName
                ecs_names.append(ecs_name)
                self.ecs[ecs_name] = self._get_ecs_info(ecs.id)
            for name in ecs_names:
                self.ports[name] = {}
                for net in self.ecs[name]['networkInfo']:
                    self.ports[name][net['networkName']] = net

    def create_ecs(self, ecs_name, flavor_name, image_name, vpc_name, volumetype_name, nics,
                   flavorType=1, anti_group=None, security_group_name='default', ecs_passwd='Huawei12#$', count=1):
        """
        -------------------
        创建ECS和BMS
        -------------------
        :param ecs_name: 云服务器名称
        :param flavor_name: 虚拟机规格名称
        :param image_name: 镜像名称
        :param vpc_name: vpc名称
        :param volumetype_name: 磁盘类型名称
        :param security_group_name: 安全组名称
        :param flavorType：取值1是VM，2是BM(可选)
        :param anti_group: 可选参数，虚拟机组id
        :param nics: 网络名称，创建双栈网口
        :param ecs_passwd: 云服务器密码
        :param count 数量
        :return: 任务ID
        """
        self._ims()
        self._vpc_ids()
        self._vpc()
        flavor_id = self._get_flavor_id(flavor_name)
        volumetype_id = self._get_volumetype_id(volumetype_name)
        vpc_id = self.vpc_ids[vpc_name]
        security_group_id = self._get_securitygroup_id(security_group_name)
        image_id = self.ims[image_name]['id']
        send_data = {
            'callerId': self.callerId,
            'meoId': self.meoId,
            'siteId': self.region_id,
            'userId': self.tenant_id,
            'userName': self.tenant_name,
            'servers': {
                'count': count,
                'flavorId': flavor_id,
                'flavorType': flavorType,
                'imageId': image_id,
                'name': ecs_name,
                'adminPass': ecs_passwd,
                'vpcId': vpc_id,
                'nics': [],
                'securityGroup': [security_group_id]
            }
        }
        nic_param = []
        if isinstance(nics, str):
            net_id = self._get_network_id(vpc_name, nics)
            nic_param.append({'networkId': net_id})
        else:
            for nic in nics:
                while len(nic) < 3:
                    nic.append('')
                net_name, ipaddr, ipaddr_v6 = nic
                net_id = self._get_network_id(vpc_name, net_name)
                if ipaddr == '':
                    nic_param.append({'networkId': net_id})
                elif ipaddr != '' and ipaddr_v6 == '':
                    nic_param.append({'networkId': net_id, 'ipAddress': ipaddr})
                elif ipaddr != '' and ipaddr_v6 != '':
                    nic_param.append({'networkId': net_id, 'ipAddress': ipaddr, 'ipAddress6': ipaddr_v6})
        send_data['servers']['nics'] = nic_param
        if anti_group is not None:
            send_data['servers']['serverGroup'] = anti_group
        if flavorType == 1:
            disk_info = [{'diskSize': 1, 'diskType': 1, 'volumeTypeID': volumetype_id}]
            send_data['servers']['diskInfo'] = disk_info
        return self.request('POST', '/v1/cloudservice/cloudservers', send_data).get('jobId')

    def check_ecs(self, ecs_name, expected_status='ACTIVE', timeout=60, interval=10):
        """
        检查ecs状态，或检查ecs是否存在
        :param ecs_name: 检查的ECS名称
        :param expected_status: 检查预期状态，当检查ecs不存在时，传入空值（None或''）；取值：SHUTOFF/ACTIVE
        :param timeout: 检查超时时间
        :param interval: 循环检查时间间隔
        :return:
        """
        times = 0
        url = f'/v1/cloudservers?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        current_ecs_detail = {}
        while times <= timeout:
            time.sleep(interval)
            times += interval
            ecss = self.request('GET', url)
            current_ecs = {}
            ecs_list = []
            # ecs_list中获取所有ecs
            if not expected_status and not ecss:
                logger.info(f'检查ECS:{ecs_name}已不存在')
                return True
            for ecs in ecss.get('servers'):
                ecs_list.append(ecs.serverName)
                if ecs.serverName == ecs_name:
                    current_ecs = ecs
            # 检查ECS已不存在
            if not expected_status and ecs_name not in ecs_list:
                logger.info(f'检查ECS {ecs_name}已不存在')
                return True
            elif not expected_status and ecs_name in ecs_list:
                continue
            # 检查ECS满足预期状态
            elif current_ecs:
                try:
                    ecs_detail = self._get_ecs_info(current_ecs['id'])
                    current_ecs_detail = ecs_detail
                except ValueError:
                    continue
                if ecs_detail.get('status') == expected_status:
                    logger.info(f'检查ECS状态成功，状态为{expected_status}')
                    return True
        if current_ecs_detail:
            logger.info(f'检查ECS状态失败，当前ECS状态为{current_ecs_detail.get("status")}，预期状态为{expected_status}')
        else:
            logger.info(f'当前ECS:{ecs_name}未删除成功')
        return False

    def get_ecs_ids(self):
        """
        获取所有ecs ID
        :return: ecsID列表
        """
        url = f'/v1/cloudservers?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        servers = self.request('GET', url).get('servers')
        ecs_ids = []
        if servers:
            for s in servers:
                ecs_ids.append(s['id'])
        return ecs_ids

    def get_ecs_detail(self, ecs_name):
        """
        --------------------------------------
        获取ECS详细信息，ECS不存在时返回空字典
        --------------------------------------
        :param ecs_name: ECS名称
        :return: ECS字典/{}
        """
        self._ecs()
        if ecs_name not in self.ecs:
            logger.info(f'ECS {ecs_name}不存在，查询ECS信息失败')
        return self.ecs.get(ecs_name)

    def get_ecs_ipaddr(self, ecs_name, network_name):
        """
        ----------------------------------------------------------------------------
        查询云主机的IP信息，返回包含ipv4和ipv6地址的列表；当没有ipv6地址时，ipv6地址返回空字符串
        ----------------------------------------------------------------------------
        :param ecs_name:
        :param network_name:
        :return: [ipv4, ipv6]
        """
        ecs_info = self.get_ecs_detail(ecs_name)
        nets = None
        for net in ecs_info['networkInfo']:
            if net['networkName'] == network_name:
                nets = net
                break
        ipv4, ipv6 = '', ''
        for sub in nets['subnetInfo']:
            if sub.get('ipv4'):
                ipv4 = sub.get('ipv4')
            if sub.get('ipv6'):
                ipv6 = sub.get('ipv6')
        return [ipv4, ipv6]

    def delete_ecs(self, *ecs_name):
        """
        -------------------
        删除云服务器
        -------------------
        :param ecs_name: 云服务器名称；可传入多个ECS名称批量删除
        :return: 任务id
        """
        url = f'/v1/cloudservers/delete?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        self._ecs_ids()
        servers = []
        if isinstance(ecs_name[0], tuple):
            ecs_name = ecs_name[0]
        for ecs in ecs_name:
            servers.append({'id': self.ecs_ids[ecs], 'siteId': self.region_id})
        send_data = {'servers': servers}
        return self.request('POST', url, send_data).get('jobId')

    def delete_ecs_by_id(self, ecs_ids):
        """
        删除云服务器
        :param ecs_name: 云服务器名称；可传入多个ECS名称批量删除
        :return: 任务id
        """
        url = f'/v1/cloudservers/delete?callerId={self.callerId}&meoId={self.meoId}&userId={self.tenant_id}'
        servers = []
        for ecs_id in ecs_ids:
            servers.append({'id': ecs_id, 'siteId': self.region_id})
        send_data = {'servers': servers}
        return self.request('POST', url, send_data).get('jobId')

    def change_ecs_name(self, ecs_name, new_ecs_name):
        """
        -------------------
        修改ecs名称
        -------------------
        :param ecs_name: 源ecs名称
        :param new_ecs_name: 新ecs名称
        :return:
        """
        self._ecs_ids()
        send_data = {
            'callerId': self.callerId,
            'meoId': self.meoId,
            'userId': self.tenant_id,
            'userName': self.tenant_name,
            'siteId': self.region_id,
            'serverId': self.ecs_ids[ecs_name],
            'name': new_ecs_name
        }
        return self.request('PUT', f'/v1/cloudservice/cloudservers/{self.ecs_ids[ecs_name]}', send_data)
